{
  "name": "app-barberia",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^24.3.0"
  },
  "dependencies": {
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "~19.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint src scripts tests/architecture tests/presentation --max-warnings 0",
    "format:check": "prettier --check src scripts tsconfig.json tsconfig.core.json tsconfig.tests.json eslint.config.js .prettierrc.json",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test": "node --test tests/architecture/check-architecture.test.mjs && node scripts/run-unit-tests.mjs && node --test tests/presentation/use-app-information.test.mjs tests/presentation/shared-ui.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run architecture:check && npm test",
    "start": "expo start --go --lan"
  }
}
