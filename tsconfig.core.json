{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": false
  },
  "include": [
    "src/features/*/domain/**/*.ts",
    "src/features/*/application/**/*.ts"
  ],
  "exclude": ["node_modules", ".test-build", "**/*.test.ts"]
}
