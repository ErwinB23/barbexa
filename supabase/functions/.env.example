# Solo desarrollo local; no copiar secretos ni aplicar en Cloud desde este archivo.
BARBERIA_ALLOWED_ORIGINS=http://localhost:8081
# 010 backend conectado tras su migración autorizada; no requiere variables nuevas.
# 011 — inactive example only; no environment/container was changed.
BARBERIA_ENABLE_ADMIN_INVITATIONS=false
BARBERIA_ENABLE_PROFESSIONAL_SUMMARY=false
# Mailpit LOCAL only, after explicit activation permission:
# BARBERIA_LOCAL_PROJECT=app-barberia-002-local
# BARBERIA_INVITATION_MAIL_PROVIDER=mailpit
# BARBERIA_INVITATION_FROM=no-reply@example.invalid
# BARBERIA_INVITATION_WEB_ORIGIN=http://localhost:8081
# Production uses the Resend adapter, approved HTTPS origin/sender and RESEND_API_KEY
# supplied privately by the runtime, never a public client variable or committed value.
