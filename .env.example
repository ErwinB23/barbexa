# Development local: use only the publishable/anon key of app-barberia-002-local.
# Copy to .env.local (ignored by Git and EAS). Never use a service/admin key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-public-key
# Local endpoints/redirects are validated in registration-environment.ts.
# Production has no local fallback and requires separately approved HTTPS settings.
# Public capability switch only; Google client secret belongs exclusively in Auth server.
# Keep false until provider and callback configuration are authorized and verified.
EXPO_PUBLIC_ENABLE_GOOGLE=false
# Enable only after applying/reviewing the separately authorized LOCAL 008 backend.
EXPO_PUBLIC_ENABLE_SELF_PROFESSIONAL=false
# 009 UI stays opt-in; activate only after SQL/Edge validation of the target environment.
EXPO_PUBLIC_ENABLE_SELF_SCHEDULE=false
# 010: no activar antes de aplicar/verificar su backend y reglas de servidor.
EXPO_PUBLIC_ENABLE_RESCHEDULE=false
# 011 stays disabled until its database/email activation is separately approved.
EXPO_PUBLIC_ENABLE_ADMIN_INVITATIONS=false
EXPO_PUBLIC_ENABLE_PROFESSIONAL_SUMMARY=false
# Integrated Cloud validation is CLOSED by default. These are public settings;
# leave the real LOCAL .env intact. Activate only after authorized backend release.
EXPO_PUBLIC_APP_ENVIRONMENT=local
# EXPO_PUBLIC_CLOUD_SUPABASE_URL=https://vuoncrtkkkquvddunrxx.supabase.co
# EXPO_PUBLIC_CLOUD_SUPABASE_PUBLISHABLE_KEY=replace-with-new-cloud-publishable-key
# EXPO_PUBLIC_CLOUD_BACKEND_REVISION=20261115230134
# EXPO_PUBLIC_APP_ENVIRONMENT=cloud-integration
# Enable separately, only after approving/configuring the Cloud mail provider.
EXPO_PUBLIC_CLOUD_ENABLE_ADMIN_INVITATIONS=false

# Activar solo tras verificación y autorización del backend Cloud de autoridad.
EXPO_PUBLIC_CLOUD_ENABLE_TEAM_AUTHORITY=false
