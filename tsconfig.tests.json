{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": false
  },
  "include": [
    "src/features/*/domain/**/*.ts",
    "src/features/*/application/**/*.ts",
    "src/features/foundation/infrastructure/local-app-information-adapter.ts",
    "tests/unit/**/*.ts"
  ],
  "exclude": ["node_modules", ".test-build", "**/*.tsx"]
}
